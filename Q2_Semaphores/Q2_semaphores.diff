diff --git a/proc.c b/proc.c
index 806b1b1..c957bcb 100644
--- a/proc.c
+++ b/proc.c
@@ -12,6 +12,18 @@ struct {
   struct proc proc[NPROC];
 } ptable;
 
+// ---- Semaphore table (Q2) ----
+#define NSEM 10
+struct semaphore {
+  int value;
+  int inited;
+  struct spinlock lk;
+};
+struct {
+  struct spinlock lock;
+  struct semaphore sem[NSEM];
+} stable;
+
 static struct proc *initproc;
 
 int nextpid = 1;
@@ -24,6 +36,7 @@ void
 pinit(void)
 {
   initlock(&ptable.lock, "ptable");
+  initlock(&stable.lock, "stable");
 }
 
 // Must be called with interrupts disabled
@@ -88,6 +101,7 @@ allocproc(void)
 found:
   p->state = EMBRYO;
   p->pid = nextpid++;
+  p->isthread = 0;
 
   release(&ptable.lock);
 
@@ -281,7 +295,7 @@ wait(void)
     // Scan through table looking for exited children.
     havekids = 0;
     for(p = ptable.proc; p < &ptable.proc[NPROC]; p++){
-      if(p->parent != curproc)
+      if(p->parent != curproc || p->isthread)
         continue;
       havekids = 1;
       if(p->state == ZOMBIE){
@@ -532,3 +546,144 @@ procdump(void)
     cprintf("\n");
   }
 }
+
+// Create a thread: shares the parent's address space (pgdir),
+// has its own kernel stack, and starts running fcn(arg) on the given user stack.
+int
+clone(void(*fcn)(void*), void *arg, void *stack)
+{
+  int i, pid;
+  uint sp;
+  struct proc *np;
+  struct proc *curproc = myproc();
+
+  if(stack == 0)
+    return -1;
+  if((np = allocproc()) == 0)
+    return -1;
+
+  np->pgdir = curproc->pgdir;
+  np->sz = curproc->sz;
+  np->parent = curproc;
+  np->isthread = 1;
+  *np->tf = *curproc->tf;
+
+  sp = (uint)stack + 4096;
+  sp -= 4;
+  *(uint*)sp = (uint)arg;
+  sp -= 4;
+  *(uint*)sp = 0xffffffff;
+
+  np->tf->eip = (uint)fcn;
+  np->tf->esp = sp;
+  np->tf->eax = 0;
+
+  for(i = 0; i < NOFILE; i++)
+    if(curproc->ofile[i])
+      np->ofile[i] = filedup(curproc->ofile[i]);
+  np->cwd = idup(curproc->cwd);
+  safestrcpy(np->name, curproc->name, sizeof(curproc->name));
+
+  pid = np->pid;
+
+  acquire(&ptable.lock);
+  np->state = RUNNABLE;
+  release(&ptable.lock);
+
+  return pid;
+}
+
+// Wait for a thread created by clone() to finish.
+// Frees only its kernel stack; the address space is shared, so it is not freed.
+int
+join(void)
+{
+  struct proc *p;
+  int havekids, pid;
+  struct proc *curproc = myproc();
+
+  acquire(&ptable.lock);
+  for(;;){
+    havekids = 0;
+    for(p = ptable.proc; p < &ptable.proc[NPROC]; p++){
+      if(p->parent != curproc || !p->isthread)
+        continue;
+      havekids = 1;
+      if(p->state == ZOMBIE){
+        pid = p->pid;
+        kfree(p->kstack);
+        p->kstack = 0;
+        p->pgdir = 0;
+        p->pid = 0;
+        p->parent = 0;
+        p->name[0] = 0;
+        p->killed = 0;
+        p->isthread = 0;
+        p->state = UNUSED;
+        release(&ptable.lock);
+        return pid;
+      }
+    }
+
+    if(!havekids || curproc->killed){
+      release(&ptable.lock);
+      return -1;
+    }
+
+    sleep(curproc, &ptable.lock);
+  }
+}
+
+// Initialize semaphore id with the given value.
+int
+sem_init(int id, int value)
+{
+  struct semaphore *s;
+
+  if(id < 0 || id >= NSEM)
+    return -1;
+  s = &stable.sem[id];
+  acquire(&stable.lock);
+  initlock(&s->lk, "sem");
+  s->value = value;
+  s->inited = 1;
+  release(&stable.lock);
+  return 0;
+}
+
+// Wait (P): block while the value is not positive, then decrement.
+int
+sem_wait(int id)
+{
+  struct semaphore *s;
+
+  if(id < 0 || id >= NSEM)
+    return -1;
+  s = &stable.sem[id];
+  if(!s->inited)
+    return -1;
+  acquire(&s->lk);
+  while(s->value <= 0)
+    sleep(s, &s->lk);
+  s->value--;
+  release(&s->lk);
+  return 0;
+}
+
+// Signal (V): increment and wake any waiting process.
+int
+sem_signal(int id)
+{
+  struct semaphore *s;
+
+  if(id < 0 || id >= NSEM)
+    return -1;
+  s = &stable.sem[id];
+  if(!s->inited)
+    return -1;
+  acquire(&s->lk);
+  s->value++;
+  wakeup(s);
+  release(&s->lk);
+  return 0;
+}
